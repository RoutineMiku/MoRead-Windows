# Electron 运行时依赖，用 npm install 还原
node_modules/

# 打包产物（含 Electron 运行时，单个 zip 就 200MB+，走 GitHub Releases）
dist/
dist-web/

# 运行时数据 / 截图临时产物
data/
.tmp-*/
*.log

# 跨平台打包：Electron 各平台运行时缓存（约 500MB），用时自动下载
.cache/
dist/_build/
dist/_trash/

# 鸿蒙：同步进来的网页版资源（由 build/sync-harmony.js 生成）
harmony/entry/src/main/resources/rawfile/web/
# 鸿蒙构建依赖与本机路径（hvigor 从 repo.harmonyos.com 装）
harmony/node_modules/
harmony/.hvigor/
harmony/local.properties
harmony/build/
harmony/entry/build/
harmony/signing/

# iOS：Xcode 中间产物（MoRead/web 是提交的，Mac 上打开工程即可直接跑）
ios/build/
ios/DerivedData/

# 本地工具链 / 测试运行目录（体积大，且只在本机有意义）
.androidenv/
test/.run/
android/

# 系统文件
Thumbs.db
.DS_Store
desktop.ini

# 微软商店打包：SDK BuildTools（约 22MB）与自签私钥，只在本机用
.msix-tools/
build/msix-test.pfx

